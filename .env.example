# Paste values WITHOUT quotes (Render env vars and .env both).
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional overrides
# LLM_CHAIN=openrouter,groq,gemini
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash
# LLM_TIMEOUT_S=30
# LLM_MAX_TOKENS=1600
# LLM_ENABLED=true
# STEP_SECONDS=1.6
# DATABASE_URL=postgresql://...   (unset = local SQLite in ./data)
# WEBHOOK_TOKEN=                   (set to require X-Webhook-Token on POST /api/events)
